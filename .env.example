# MongoDB (matches docker-compose credentials)
# authSource=admin is required: the root user is created in the `admin` db,
# so auth must be checked there even though we use the `cortex` database.
MONGODB_URL=mongodb://admin:cortex@localhost:27017/?authSource=admin
MONGODB_DB_NAME=cortex

# Redis
REDIS_URL=redis://localhost:6379

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# App
ENVIRONMENT=local
DEBUG=true

# Google Cloud / Vertex AI (only the Claude Agent SDK pipeline uses these)
# Auth, pick one:
#   1. run `gcloud auth application-default login` (leave GCP_CREDENTIALS_PATH empty), or
#   2. set GCP_CREDENTIALS_PATH to a service-account key JSON (~ is expanded).
GCP_PROJECT_ID=
VERTEX_REGION=global
GCP_CREDENTIALS_PATH=

# OpenAI (the only model provider)
OPENAI_API_KEY=

# Cartesia (speech-to-text and text-to-speech)
CARTESIA_API_KEY=
