# MongoDB (matches docker-compose credentials)
# authSource=admin is required: the root user is created in the `admin` db,
# so auth must be checked there even though we use the `cortex` database.
MONGODB_URL=mongodb://admin:cortex@localhost:27017/?authSource=admin
MONGODB_DB_NAME=cortex

# Redis
REDIS_URL=redis://localhost:6379

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# App
ENVIRONMENT=local
DEBUG=true

# The model a gem answers with, in a call or in writing, when its config names none:
# "6 Luna", "6.1 Terra" or "6.1 Sol" (OpenAI), or "Haiku 5.5", "Sonnet 5.5" or "Opus 5.5"
# (Anthropic). A model's provider needs a key.
VOICE_MODEL=6 Luna

# OpenAI
OPENAI_API_KEY=
# OpenAI through a proxy, such as CLIProxyAPI signed in with a ChatGPT account. With this
# and OPENAI_API_KEY both set, the app chooses which one is used; the proxy until it does.
OPENAI_PROXY_URL=
OPENAI_PROXY_KEY=

# Anthropic: a key for the Claude API itself, from platform.claude.com
ANTHROPIC_API_KEY=

# Cartesia (speech-to-text and text-to-speech)
CARTESIA_API_KEY=

# Parallel (web search tool for the voice pipeline; leave empty to run without it)
PARALLEL_API_KEY=
